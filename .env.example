# Copy to the server as RUNTIME_DIR/.env (e.g. /var/www/clavis-site/.env).
# Локально — относительный путь; на сервере — АБСОЛЮТНЫЙ (иначе build и migrate
# могут смотреть в разные SQLite-файлы):
#   DATABASE_URL="file:/var/www/clavis-site/data/prod.db"
DATABASE_URL="file:./data/dev.db"
PORT=3000
NODE_VERSION=24

# Админка (смените в продакшене)
# Значения в кавычках, если в пароле есть $ # ! и пробелы
# Локально (next dev) вход без логина/пароля — автоматически
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"
ADMIN_SESSION_SECRET="change-this-to-a-long-random-string"
# true только после HTTPS (иначе сессия админки сбрасывается на http://IP/)
ADMIN_COOKIE_SECURE="false"
