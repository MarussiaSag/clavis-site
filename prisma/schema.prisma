// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id                Int      @id @default(1)
  city              String
  address           String
  mapUrl            String
  phone             String
  phoneHref         String
  email             String
  tagline           String
  hoursWeekdays     String
  hoursWeekend      String
  instagramFootnote String
  updatedAt         DateTime @updatedAt
}

model SocialLink {
  id        Int      @id @default(autoincrement())
  label     String
  href      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudioHighlight {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AboutStudio {
  id        Int                 @id @default(1)
  teamPhoto String
  updatedAt DateTime            @updatedAt
  people    AboutStudioPerson[]
}

model AboutStudioPerson {
  id            Int         @id @default(autoincrement())
  name          String
  role          String
  competencies  String
  sortOrder     Int         @default(0)
  aboutStudioId Int         @default(1)
  aboutStudio   AboutStudio @relation(fields: [aboutStudioId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  category    String
  location    String
  year        Int
  coverImage  String
  description String
  areaLabel      String?
  durationLabel  String?
  taskBrief      String?
  styleLabel     String?
  layoutLabel    String?
  aboutSummary   String?
  quote          String?
  quoteAttribution String?
  aboutBody      String?
  aboutSideBody  String?
  aboutImage     String?
  roomsJson      String?
  materialsJson  String?
  teamJson       String?
  virtualTourUrl String?
  isFeaturedHome Boolean  @default(false)
  showOnHero  Boolean  @default(true)
  heroOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

model BlogPost {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  coverImage      String
  publishedAt     DateTime
  readingMinutes  Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteImage {
  id        Int      @id @default(autoincrement())
  slot      String   @unique
  url       String
  updatedAt DateTime @updatedAt
}
